@page "/document-designer"
@rendermode InteractiveServer
@using TemplateGenerator.Application.Contracts
@using TemplateGenerator.Application.Services
@using TemplateGenerator.Domain
@inject IDocumentConversionService DocumentConversionService
@inject IDocumentUploadValidator UploadValidator

<PageTitle>Document Designer</PageTitle>

<div class="doc-designer-shell">
    <FluentStack Orientation="Orientation.Vertical" Gap="">
        <FluentText Typography="Typography.H3">Word → HTML → PDF</FluentText>

        <FluentGrid Justify="JustifyContent.FlexStart" Style="width: 100%;">
            <FluentGridItem xs="12" md="6">
                <div class="editor-panel">
                    <FluentLabel>Upload Microsoft Word document</FluentLabel>
                    <InputFile OnChange="HandleFileSelected" />

                    @if (!string.IsNullOrWhiteSpace(_statusMessage))
                    {
                        <FluentDivider />
                        <div class="status-text">@_statusMessage</div>
                    }
                </div>
            </FluentGridItem>

            <FluentGridItem xs="12" md="6">
                <div class="editor-panel">
                    <FluentLabel>Print settings</FluentLabel>

                    <div class="page-size-inline">
                        <FluentSelect TValue="PaperSize"
                                      TOption="PaperSize"
                                      Items="Enum.GetValues<PaperSize>()"
                                      OptionText="@(v => v.ToString())"
                                      @bind-Value="_pageSettings.Size" />

                        <FluentSelect TValue="PageOrientation"
                                      TOption="PageOrientation"
                                      Items="Enum.GetValues<PageOrientation>()"
                                      OptionText="@(v => v.ToString())"
                                      @bind-Value="_pageSettings.Orientation" />
                    </div>
                </div>
            </FluentGridItem>
        </FluentGrid>

        @if (!string.IsNullOrWhiteSpace(_htmlPreview))
        {
            <FluentDivider />

            <div class="preview-toolbar">
                <FluentLabel>Preview</FluentLabel>

                <div class="tab-group">
                    <button class="tab-button @( _activePreviewTab == "html" ? "active" : "" )"
                            type="button"
                            @onclick='() => SetPreviewTab("html")'>
                        HTML
                    </button>

                    <button class="tab-button @( _activePreviewTab == "browser" ? "active" : "" )"
                            type="button"
                            @onclick='() => SetPreviewTab("browser")'>
                        Browser
                    </button>

                    <button class="tab-button @( _activePreviewTab == "pdf" ? "active" : "" )"
                            type="button"
                            @onclick='() => SetPreviewTab("pdf")'>
                        PDF Preview
                    </button>

                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  OnClick="ExportPdfAsync">
                        Export PDF
                    </FluentButton>
                </div>
            </div>

            <div class="preview-surface">
                @switch (_activePreviewTab)
                {
                    case "html":
                        <pre class="html-source">@_htmlPreview</pre>
                        break;

                    case "pdf":
                        if (!string.IsNullOrWhiteSpace(_pdfPreviewDataUrl))
                        {
                            <iframe class="preview-frame" src="@_pdfPreviewDataUrl" />
                        }
                        else
                        {
                            <div class="empty-state">
                                Export PDF before previewing the PDF version.
                            </div>
                        }
                        break;

                    default:
                        <iframe class="preview-frame" srcdoc="@_htmlPreview" />
                        break;
                }
            </div>
        }
    </FluentStack>
</div>

@code {
    private string? _statusMessage;
    private string? _htmlPreview;
    private string? _pdfPreviewDataUrl;
    private string _activePreviewTab = "browser";
    private readonly PageSettings _pageSettings = new();

    private void SetPreviewTab(string tab)
    {
        _activePreviewTab = tab;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        try
        {
            UploadValidator.Validate(file.OpenReadStream(), file.Name);

            await using var stream = file.OpenReadStream(20L * 1024 * 1024);
            var result = await DocumentConversionService.ParseWordAsync(stream);
            _htmlPreview = DocumentConversionService.RenderHtml(result);
            _pdfPreviewDataUrl = null;
            _activePreviewTab = "browser";
            _statusMessage = $"Loaded: {file.Name}";
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _htmlPreview = null;
            _pdfPreviewDataUrl = null;
            _activePreviewTab = "browser";
        }
    }

    private async Task ExportPdfAsync()
    {
        if (string.IsNullOrWhiteSpace(_htmlPreview))
            return;

        try
        {
            var pdfBytes = await DocumentConversionService.ExportPdfAsync(_htmlPreview, _pageSettings);
            _pdfPreviewDataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}";
            _activePreviewTab = "pdf";

            var fileName = $"document-{DateTime.UtcNow:yyyyMMddHHmmss}.pdf";
            await JS.InvokeVoidAsync("downloadFile", fileName, "application/pdf", Convert.ToBase64String(pdfBytes));
            _statusMessage = $"PDF exported: {fileName}";
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;
}
